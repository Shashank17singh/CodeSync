PORT=3000
DATABASE_URL=postgresql://codesync:codesync@localhost:5432/codesync
REDIS_URL=redis://localhost:6379
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
COLLAB_TOKEN_SECRET=must-match-the-collab-server-value
INVITE_TOKEN_SECRET=replace-with-at-least-32-random-characters
OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
# Mailpit from infra/compose. Open http://localhost:8025 to read the mail it catches.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=CodeSync <no-reply@codesync.local>
# Browsers refuse Secure cookies on plain http, so set this to false only for local development.
COOKIE_SECURE=false
# Number of proxies in front of the API. Keep 0 unless one is really there, or clients can spoof
# their IP address through X-Forwarded-For and escape rate limits. Use 1 behind Nginx.
TRUST_PROXY_HOPS=0
# Leave a pair empty to turn that login provider off.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOG_LEVEL=info
