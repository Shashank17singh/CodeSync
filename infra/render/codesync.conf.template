map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

upstream api_server {
  server 127.0.0.1:3000;
}

upstream collab_server {
  least_conn;
  server 127.0.0.1:4000;
}

server {
  listen ${PORT};
  server_name _;

  client_max_body_size 10m;

  # Health check for Render deployment verification
  location /healthz {
    proxy_pass http://api_server/healthz;
    proxy_set_header Host $host;
  }

  # Fastify REST API
  location /api/ {
    proxy_pass http://api_server;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Yjs WebSocket Collaboration Server
  location /collab/ {
    proxy_pass http://collab_server;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # Root health endpoint
  location / {
    default_type application/json;
    return 200 '{"status":"ok","service":"codesync-backend"}';
  }
}
