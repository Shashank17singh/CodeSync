map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# Allow Vercel frontends and local dev
map $http_origin $cors_origin {
  default "";
  "~^https://.*\.vercel\.app$" "$http_origin";
  "~^http://localhost(:\d+)?$" "$http_origin";
}

upstream api_server {
  server 127.0.0.1:3000;
}

upstream collab_server {
  least_conn;
  server 127.0.0.1:4000;
}

server {
  listen ${PORT};
  server_name _;

  client_max_body_size 10m;

  # Health check for Render deployment verification
  location /healthz {
    proxy_pass http://api_server/healthz;
    proxy_set_header Host $host;
  }

  # Fastify REST API
  location /api/ {
    if ($request_method = 'OPTIONS') {
      add_header 'Access-Control-Allow-Origin' '$cors_origin' always;
      add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
      add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, x-csrf-token' always;
      add_header 'Access-Control-Allow-Credentials' 'true' always;
      add_header 'Content-Length' 0;
      add_header 'Content-Type' 'text/plain charset=UTF-8';
      return 204;
    }

    add_header 'Access-Control-Allow-Origin' '$cors_origin' always;
    add_header 'Access-Control-Allow-Credentials' 'true' always;

    proxy_pass http://api_server;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Yjs WebSocket Collaboration Server
  location /collab/ {
    access_log off;
    proxy_pass http://collab_server;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # Root health endpoint
  location / {
    default_type application/json;
    return 200 '{"status":"ok","service":"codesync-backend"}';
  }
}
