# Copy to .env.prod on the application host. Never commit the copy.
# Generate each secret with: openssl rand -base64 48
POSTGRES_PASSWORD=
REDIS_PASSWORD=
GRAFANA_PASSWORD=
ACCESS_TOKEN_SECRET=
COLLAB_TOKEN_SECRET=
INVITE_TOKEN_SECRET=
OAUTH_STATE_SECRET=
INTERNAL_SERVICE_TOKEN=
PUBLIC_WEB_URL=https://codesync.example.edu
PUBLIC_API_URL=https://codesync.example.edu
SMTP_URL=smtp://user:password@mail.example.edu:587
MAIL_FROM=CodeSync <no-reply@example.edu>
# The folder holding fullchain.pem and privkey.pem.
TLS_CERT_DIR=/etc/letsencrypt/live/codesync.example.edu
# Private addresses. Firewall Redis so that only the executor host can reach it.
PRIVATE_IP=10.0.0.2
EXECUTOR_PRIVATE_IP=10.0.0.3
# Leave a pair empty to turn that login provider off.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
