# Copy to .env.prod on the application host. Never commit the copy.
# infra/deploy/setup-server.sh writes this file for you. To do it by hand, make each secret with
# `openssl rand -hex 32`. Hex matters: these values also go inside connection URLs.
DOMAIN=codesync.example.edu
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Only for the monitoring profile.
GRAFANA_PASSWORD=
ACCESS_TOKEN_SECRET=
COLLAB_TOKEN_SECRET=
INVITE_TOKEN_SECRET=
OAUTH_STATE_SECRET=
INTERNAL_SERVICE_TOKEN=
PUBLIC_WEB_URL=https://codesync.example.edu
PUBLIC_API_URL=https://codesync.example.edu
# Without working mail, nobody can verify a new account.
SMTP_URL=smtp://user:password@mail.example.edu:587
MAIL_FROM=CodeSync <no-reply@example.edu>
# Blank builds on the server. For prebuilt images use ghcr.io/<owner>/<repo> in lower case.
IMAGE_PREFIX=
IMAGE_TAG=latest
# Only with a separate executor host. See docs/deployment.md.
PRIVATE_IP=
EXECUTOR_PRIVATE_IP=
# Leave a pair empty to turn that login provider off.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
